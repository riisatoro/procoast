DEBUG=1
SECRET_KEY=change-me

POSTGRES_DB=procoast
POSTGRES_USER=procoast
POSTGRES_PASSWORD=procoast
POSTGRES_HOST=procoast-db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=admin

GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=60
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_RELOAD=1
# Recycle each worker after this many requests (0 disables). Prevents a worker
# from degrading until the API stops responding.
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
# Supervisor: GET /api/health/ every HEALTH_INTERVAL seconds and restart
# gunicorn after HEALTH_FAIL_THRESHOLD consecutive failures.
HEALTH_INTERVAL=30
HEALTH_FAIL_THRESHOLD=3
HEALTH_START_PERIOD=20
